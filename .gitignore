# =====================================================
# Unity: carpetas generadas, se reconstruyen solas
# =====================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Carpetas de paquetes descargados
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Archivos de proyecto de los editores (se regeneran)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Compilados
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties

# =====================================================
# ML-Agents / Python
# =====================================================

# Entorno virtual: ocupa cientos de MB y se recrea con pip
/venv-mlagents/
/venv/
/.venv/

# Resultados de entrenamiento: modelos y estadísticas.
# Se ignoran por tamaño; los modelos finales se versionan aparte.
/results/

# Caché de Python
__pycache__/
*.py[cod]

# =====================================================
# Registros propios del proyecto
# =====================================================

# Archivos generados por RegistroLog durante las pruebas
/Logs/
log_partida_*.txt